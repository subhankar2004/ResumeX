# =============================================================================
# ResumeX Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=resumex_db
POSTGRES_USER=resumex
POSTGRES_PASSWORD=resumex_dev_password

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# LaTeX Compiler Service
# -----------------------------------------------------------------------------
LATEX_COMPILER_URL=http://latex-compiler:5001
LATEX_COMPILE_TIMEOUT=10000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# OAuth (social sign-in)
# -----------------------------------------------------------------------------
# Public URLs the browser is redirected to (not Docker-internal hostnames)
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# GitHub OAuth App — callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (Web application) — redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# -----------------------------------------------------------------------------
# Optional: Post-MVP Features
# -----------------------------------------------------------------------------
# Gemini API for the AI resume interviewer (Rex) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model, thinking level (minimal/low/medium/high) and request timeout (ms)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# AI_TIMEOUT=30000
# Rex Writer (one ATS rewrite per build): model, thinking level, timeout (ms)
# GEMINI_WRITER_MODEL=gemini-3.5-flash-lite
# GEMINI_WRITER_THINKING_LEVEL=low
# AI_WRITER_TIMEOUT=60000

# Stripe for subscriptions (Post-MVP)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
